{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ParkingSysLog",
  "version": "0.1.0",
  "identifier": "com.parkingsyslog.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "停车收费记录解析工具",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
